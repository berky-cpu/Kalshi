# Copy to .env on the VPS only. Never commit .env.
# Kalshi DEMO credentials (orders) — https://demo.kalshi.co
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=secrets/kalshi_demo.pem
# Kalshi production credentials — market-data WebSocket only, never orders
KALSHI_DATA_KEY_ID=
KALSHI_DATA_PRIVATE_KEY_PATH=secrets/kalshi_data.pem
# Coinbase Exchange (level3/full channel requires auth)
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=
# Kraken (WebSocket v2 level3 token)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
DATA_ROOT=data/raw
