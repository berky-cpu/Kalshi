# deploy/env.example — TEMPLATE for the VPS secrets file /etc/kbtc/env
#
# This is a NON-SECRET template committed to the repo. The REAL file lives ONLY on the VPS at
# /etc/kbtc/env, owned by root, chmod 600, and is NEVER committed (the repo's .gitignore excludes
# .env / .env.* / secrets/, and /etc/kbtc is outside the repo entirely). Code reads these from the
# process environment; it never reads this file directly and never prints these values.
#
# systemd EnvironmentFile format: KEY=VALUE, one per line, no `export`, no shell expansion.
# !!! NO INLINE COMMENTS ON A KEY=VALUE LINE !!!  systemd reads the REST OF THE LINE as the value,
# so `KRAKEN_API_SECRET=abc   # note` sets the secret to "abc   # note" and auth will fail. Put
# comments on their OWN line (like these), never after a value.

# --- Coinbase Exchange (full / level3 require auth since 2023-07-01) -----------------------------
# COINBASE_API_SECRET is the base64 secret as issued by Coinbase Exchange.
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# --- Kraken (level3 needs a WebSocket token from GetWebSocketsToken) ------------------------------
# The key needs the "WebSocket interface" permission (read-only; NO trade). SECRET = base64 private
# key as issued by Kraken.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Kalshi (market-data READS only; production host; no order path) -----------------------------
# KALSHI_API_KEY_ID is the access-key id (NOT the private key).
# KALSHI_PRIVATE_KEY_PATH points at the RSA/Ed25519 PEM on the box (chmod 600).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/kbtc/kalshi-private-key.pem
# Kalshi subscription scope (ROADMAP 1.3). Two mutually-exclusive modes:
#   DYNAMIC (recommended for 24/7 capture): set KBTC_KALSHI_SERIES. The recorder discovers the
#     currently-open markets (public REST), subscribes on one stable connection, and tracks the
#     15-min roll with `update_subscription` add/delete (no reconnect). VERIFIED on the wire
#     2026-10-17 (see docs/feeds.md).
#   STATIC (tests / one-off): set KBTC_KALSHI_TICKERS to a comma-separated fixed list. Takes
#     precedence over KBTC_KALSHI_SERIES if both are set. Subscribes once, no poller.
#   LEGACY (neither set): subscribe with no ticker filter.
KBTC_KALSHI_SERIES=KXBTC15M
# KBTC_KALSHI_TICKERS=
# Optional (dynamic mode): re-discovery interval in seconds (default 45) and the per-market
# channels to track dynamically (default "orderbook_delta,trade").
# KBTC_KALSHI_POLL_S=45
# KBTC_KALSHI_CHANNELS=orderbook_delta,trade
# Dynamic mode PRE-SUBSCRIBES the upcoming window(s) BEFORE they open, so the new market's
# open-window (the strike-forming 60 s) is captured with ZERO gap at the :00/:15/:30/:45 roll.
# KBTC_KALSHI_LOOKAHEAD = how many upcoming windows to pre-subscribe (default 1, hard-capped 2).
# KBTC_KALSHI_REMOVE_GRACE_S = keep a closed market subscribed this long so its final frames are
# captured before it is dropped (default 120).
# KBTC_KALSHI_LOOKAHEAD=1
# KBTC_KALSHI_REMOVE_GRACE_S=120

# --- Off-site backup (rclone; target UNDECIDED, so remote-agnostic) ------------------------------
# e.g. b2:my-bucket/kbtc  |  r2:my-bucket/kbtc  |  s3:my-bucket/kbtc
# RCLONE_CONFIG is set by the backup unit to /etc/kbtc/rclone.conf; put the remote's creds there.
KBTC_BACKUP_REMOTE=

# --- Failure alerting (ntfy push; alerting #3b) --------------------------------------------------
# KBTC_ALERT_URL is an ntfy TOPIC URL that alert.sh POSTs failure messages to. The topic string is
# the ONLY access control, so make it long and UNGUESSABLE (treat it like a secret; never commit a
# real one). Subscribe in the ntfy app (or https://ntfy.sh) to that topic to receive pushes.
#   e.g.  KBTC_ALERT_URL=https://ntfy.sh/kbtc-7f3c1a9e2b4d6f80-alerts
# Leave UNSET to disable alerting (alert.sh no-ops cleanly). Used by kbtc-alert@ (OnFailure of
# backup/disk-alarm/settlement) and by the kbtc-liveness backstop.
KBTC_ALERT_URL=
