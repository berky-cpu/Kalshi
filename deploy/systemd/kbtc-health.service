# Periodic recorder health report (ROADMAP 1.4). Exits non-zero when ANY feed is unhealthy
# (stale, too quiet, or gappy), which marks the systemd unit failed -> OnFailure alert can fire.
[Unit]
Description=kbtc recorder health report
Documentation=file:///opt/kbtc/docs/feeds.md
# NO OnFailure here (alerting #3b, option b). The health CLI exits non-zero on ANY unhealthy feed,
# which — via the cross-feed late-start gate (down_from_start) — includes a single feed that was
# recently restarted while the others kept running (a brief, self-healing state). Paging on that
# would false-alarm on every routine systemd restart. Genuine data-staleness is paged instead by
# the dedicated kbtc-liveness backstop, which gates strictly on newest-DATA-frame age (never on the
# late-start flag). This unit still runs + logs the full report for observability.

[Service]
Type=oneshot
User=kbtc
Group=kbtc
WorkingDirectory=/opt/kbtc
EnvironmentFile=-/etc/kbtc/env
# Window the report to the last 15 min (epoch ns, which the CLI accepts) so a single stalled feed
# trips promptly instead of being diluted across the whole history. GNU `date` is standard on
# Ubuntu; `%%` escapes `%` for systemd.
ExecStart=/bin/sh -c '/opt/kbtc/.venv/bin/python -m kbtc.recorders.health --root /opt/kbtc/data/raw --start $(date -u -d "15 min ago" +%%s%%N)'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kbtc-health

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Health only READS the data tree; no write access needed.
ReadOnlyPaths=/opt/kbtc/data
